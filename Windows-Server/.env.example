# Owner Tracker V11 — copy secrets through windows/SETUP_FIRST.cmd. Never publish .env.
PORT=8787
HOST=127.0.0.1
OWNERTRACKER_DB=./data/ownertracker.sqlite
OWNERTRACKER_ADMIN_USER=owner
OWNERTRACKER_ADMIN_PASSWORD=CHANGE_ME_NOW
OWNERTRACKER_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
QBPOS_BRIDGE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN
# Historical import is disabled by default. A reviewed migration may use
# insert-only; existing jobs, payments and lines are never overwritten.
QBPOS_IMPORT_MODE=disabled
DESKTOP_AGENT_TOKEN=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_TOKEN

SHOP_NAME=AZ Jet Ski, Boats & Powersports
SHOP_PHONE=602-482-9322
SHOP_LOGO_URL=/brand-logo.png
SHOP_LABOR_RATE=140
# Public invoice/customer links require verified HTTPS. Local URLs are rejected.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# 9.1% default is initialized and controlled by the Settings API. Ask accountant to verify.
# SMTP via a sender mailbox with app-specific password (or configure SendGrid below).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
INVOICE_FROM_EMAIL=
SENDGRID_API_KEY=

# Epson Ethernet printer with cash drawer physically attached to printer
EPSON_PRINTER_IP=
EPSON_PRINTER_PORT=9100
EPSON_DRAWER_PIN=0


# Google Calendar Owner Tracker → jetskiarizona@gmail.com (opt-in; HTTPS callback)
# Enable Google Calendar API and register a Google OAuth Web Application redirect URI.
# Use a cryptographically random 32-byte key (64 hex characters); setup generates this key.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URL=
GOOGLE_CALENDAR_TOKEN_KEY=
GOOGLE_CALENDAR_EMAIL=jetskiarizona@gmail.com

# Customer notifications and operational alerts
NOTIFY_WEBHOOK_URL=

# Dejavoo P1 / iPOSpays. DO NOT enable live processing without vendor-verified integration.
DEJAVOO_SPIN_AUTH_KEY=
DEJAVOO_SPIN_REGISTER_ID=
DEJAVOO_HPP_API_KEY=
DEJAVOO_HPP_ENDPOINT=

# DocuSign: app OAuth separate from connected ChatGPT account; explicit legal policy approval.
DOCUSIGN_MODE=disabled
DOCUSIGN_BASE_URL=https://na4.docusign.net
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_TEMPLATE_ID=
DOCUSIGN_ENABLE_SEND=false
DOCUSIGN_POLICY_APPROVED=false

# Supplier lookup, status updates and ordering (live checkout OFF)
AUTO_BUILD_PROCUREMENT=true
AUTO_SUPPLIER_LOOKUP=false
SUPPLIER_LOOKUP_WEBHOOK_URL=
SUPPLIER_LOOKUP_WEBHOOK_TOKEN=
VENDOR_ORDER_WEBHOOK_URL=
VENDOR_ORDER_WEBHOOK_TOKEN=
VENDOR_STATUS_WEBHOOK_URL=
VENDOR_STATUS_WEBHOOK_TOKEN=
LIVE_VENDOR_ORDERING=false

# Desktop command receiver: defaults to local POS server
DESKTOP_SERVER_URL=http://127.0.0.1:8787
ORDER_OUTBOX_DIR=./data/order-manifests
NODE_ENV=production

# Shop launch controls (configure privately; never commit real keys)
REQUIRE_EDIT_REVISION=true
TRUST_PROXY=false
# 32 random bytes expressed as 64 hex digits; preserve an offline recovery copy.
OWNERTRACKER_BACKUP_KEY=
AUTO_ENCRYPTED_BACKUP=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN_COUNT=30
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_TOKEN=
NOTIFICATIONS_AUTO_SEND=false
EMAIL_PREFERENCES_SIGNING_KEY=
